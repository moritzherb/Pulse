# Supabase — project settings → API
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only. Never expose to the client; used by nothing that reads pings.
SUPABASE_SERVICE_ROLE_KEY=

# Basemap. MapTiler free tier; leave blank to fall back to the keyless
# OpenStreetMap/CARTO dark raster style.
NEXT_PUBLIC_MAPTILER_KEY=

# Policy version shown on the consent screen and stored with consent records.
# Bump this to re-prompt every user.
NEXT_PUBLIC_POLICY_VERSION=2026-07-01
