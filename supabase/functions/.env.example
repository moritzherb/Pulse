# Optional Edge Function settings. Local: `supabase functions serve --env-file supabase/functions/.env`
# Hosted: `npx supabase secrets set NAME=value`
# SUPABASE_URL, SUPABASE_ANON_KEY and SUPABASE_SERVICE_ROLE_KEY are provided by Supabase.

# Minimum seconds between two accepted pings from one identity (default 60).
PING_MIN_INTERVAL_SECONDS=60
# New identities must be this old before their pings count (default 120). 0 for local testing.
PING_MIN_ACCOUNT_AGE_SECONDS=120
