# Copy to .env and fill in. Never commit .env.
#
# EXPO_PUBLIC_* values are bundled into the app and are public by design.
# Restart `npm start` after changing them (they are read at bundle time).

# Supabase -> Project Settings -> API: Project URL and the anon / publishable key.
# Leave empty to run the app on simulated data (development builds only).
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# Policy version shown on the consent screen and stored with consent records.
# Bump it to re-prompt every user.
EXPO_PUBLIC_POLICY_VERSION=2026-10-29

# --- Not bundled: used only by scripts on your computer -------------------
# Direct Postgres connection for the seed script.
# Supabase -> Connect -> Session pooler (or local: postgresql://postgres:postgres@127.0.0.1:54322/postgres)
DATABASE_URL=
