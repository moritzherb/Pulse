# Copy to .env and fill in. Never commit .env.
# Values prefixed EXPO_PUBLIC_ are bundled into the app and are public by design.

# Supabase project URL and anon (publishable) key. Settings -> API. (Phase 2)
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# Policy version shown on the consent screen and stored with consent records.
# Bump it to re-prompt every user.
EXPO_PUBLIC_POLICY_VERSION=2026-10-27
