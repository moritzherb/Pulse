{
  "name": "pulse",
  "version": "0.1.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start --dev-client",
    "ios": "expo run:ios",
    "android": "expo run:android",
    "typecheck": "tsc --noEmit && tsc --noEmit -p scripts/tsconfig.json",
    "lint": "eslint .",
    "test": "jest",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "seed": "tsx --env-file-if-exists=.env scripts/seed-vienna.ts",
    "db:test": "bash supabase/tests/local/run.sh",
    "functions:check": "cd supabase/functions && npx --yes deno@2 check ping/index.ts delete-me/index.ts import-region/index.ts",
    "import:osm": "tsx --env-file-if-exists=.env scripts/import-osm.ts",
    "cities": "tsx scripts/build-cities.ts"
  },
  "dependencies": {
    "@expo-google-fonts/arimo": "^0.4.3",
    "@expo-google-fonts/ibm-plex-mono": "^0.4.1",
    "@gorhom/bottom-sheet": "^5.2.14",
    "@maplibre/maplibre-react-native": "^11.5.0",
    "@supabase/supabase-js": "^2.118.0",
    "expo": "~58.0.19",
    "expo-constants": "~58.0.13",
    "expo-dev-client": "~58.0.15",
    "expo-font": "~58.0.10",
    "expo-haptics": "~58.0.7",
    "expo-linking": "~58.0.14",
    "expo-location": "~58.0.19",
    "expo-router": "~58.0.26",
    "expo-splash-screen": "~58.0.11",
    "expo-sqlite": "~58.0.14",
    "expo-status-bar": "~58.0.4",
    "expo-system-ui": "~58.0.6",
    "h3-js": "^4.5.0",
    "react": "19.3.0",
    "react-native": "0.88.0",
    "react-native-gesture-handler": "~3.3.0",
    "react-native-reanimated": "4.7.1",
    "react-native-safe-area-context": "~5.10.1",
    "react-native-screens": "~4.30.0",
    "react-native-svg": "15.16.0",
    "react-native-url-polyfill": "^4.0.0",
    "react-native-worklets": "0.13.0"
  },
  "devDependencies": {
    "@photostructure/tz-lookup": "^11.7.0",
    "@react-native/jest-preset": "^0.88.0",
    "@types/geojson": "^7946.0.16",
    "@types/jest": "^30.0.0",
    "@types/react": "~19.3.0",
    "all-the-cities": "^3.1.0",
    "eslint": "^9.39.5",
    "eslint-config-expo": "~58.0.4",
    "eslint-config-prettier": "^10.1.8",
    "jest": "^30.5.2",
    "jest-expo": "~58.0.0",
    "postgres": "^3.4.9",
    "prettier": "^3.9.10",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3"
  },
  "overrides": {
    "react-dom": "19.3.0"
  },
  "jest": {
    "preset": "jest-expo",
    "moduleNameMapper": {
      "^@/(.*)$": "<rootDir>/src/$1",
      "^@shared/(.*)$": "<rootDir>/supabase/functions/_shared/$1"
    },
    "testPathIgnorePatterns": [
      "/node_modules/",
      "/design/"
    ]
  }
}
